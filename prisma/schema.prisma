// Business Compliance Partner — PostgreSQL Schema (Prisma ORM v6)
// Course Mode A (Catalogue + Enquiry), Services, Licensing, Consultancy Leads,
// Staff-only Admin CMS & Audit Trail. No Phase 2/3 LMS/Payments/Portal tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PillarType {
  COURSES
  SERVICES
  LICENSING
  CONSULTANCY
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
}

enum AvailabilityStatus {
  ACTIVE
  UPCOMING
  INTEREST_ONLY
  INACTIVE
}

enum LeadStatus {
  NEW
  REVIEWED
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
  SPAM
}

enum AdminRole {
  ADMIN
  EDITOR
  LEAD_MANAGER
}

enum PreferredContact {
  PHONE
  WHATSAPP
  EMAIL
  ANY
}

model Category {
  id               String           @id @default(cuid())
  pillar           PillarType
  slug             String
  nameBn           String
  nameEn           String
  shortDescBn      String
  shortDescEn      String?
  iconName         String?
  sortOrder        Int              @default(0)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  courses          Course[]
  services         Service[]
  licensingEntries LicensingEntry[]

  @@unique([pillar, slug])
  @@index([pillar, isActive, sortOrder])
  @@map("categories")
}

model Instructor {
  id                   String   @id @default(cuid())
  nameBn               String
  nameEn               String?
  titleBn              String?
  bioBn                String?
  credentialsSummaryBn String?
  isVerified           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  courses              Course[]

  @@map("instructors")
}

model Course {
  id                 String             @id @default(cuid())
  slug               String             @unique
  titleBn            String
  titleEn            String?
  summaryBn          String
  summaryEn          String?
  categoryId         String
  category           Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  audienceBn         String
  outcomes           String[]
  syllabus           Json
  aliases            String[]           @default([])
  // Populate ONLY when client verifies delivery, duration, fee, and instructor.
  deliveryMode       String?
  duration           String?
  feeDisplay         String?
  instructorId       String?
  instructor         Instructor?        @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  contentStatus      ContentStatus      @default(DRAFT)
  availabilityStatus AvailabilityStatus @default(INTEREST_ONLY)
  featured           Boolean            @default(false)
  sortOrder          Int                @default(0)
  seoTitle           String?
  seoDescription     String?
  lastVerifiedAt     DateTime?
  verifiedBy         String?
  sourceReference    String?
  modules            CourseModule[]
  enrollments        Enrollment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([contentStatus, availabilityStatus, featured, sortOrder])
  @@index([categoryId])
  @@map("courses")
}

model Service {
  id                  String             @id @default(cuid())
  slug                String             @unique
  titleBn             String
  titleEn             String?
  summaryBn           String
  summaryEn           String?
  categoryId          String
  category            Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  whoNeedsItBn        String
  assistanceScopeBn   String
  limitationsBn       String
  documentsSummary    String[]
  processSteps        Json
  authorityName       String?
  officialSourceLabel String?
  officialSourceUrl   String?
  requiresSpecialist  Boolean            @default(false)
  aliases             String[]           @default([])
  // Keep BCP service fee notes strictly separate from government fees.
  serviceFeeNoteBn    String?
  govtFeeNoteBn       String?
  contentStatus       ContentStatus      @default(DRAFT)
  availabilityStatus  AvailabilityStatus @default(INTEREST_ONLY)
  featured            Boolean            @default(false)
  sortOrder           Int                @default(0)
  seoTitle            String?
  seoDescription      String?
  lastVerifiedAt      DateTime?
  verifiedBy          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([contentStatus, availabilityStatus, featured, sortOrder])
  @@index([categoryId])
  @@map("services")
}

model LicensingEntry {
  id                  String             @id @default(cuid())
  slug                String             @unique
  titleBn             String
  titleEn             String?
  summaryBn           String
  summaryEn           String?
  categoryId          String
  category            Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  authorityName       String
  authorityType       String
  officialSourceLabel String
  officialSourceUrl   String?
  serviceScopeBn      String
  limitationsBn       String
  documentsSummary    String[]
  processSummaryBn    String
  aliases             String[]           @default([])
  contentStatus       ContentStatus      @default(DRAFT)
  availabilityStatus  AvailabilityStatus @default(INTEREST_ONLY)
  featured            Boolean            @default(false)
  sortOrder           Int                @default(0)
  seoTitle            String?
  seoDescription      String?
  lastVerifiedAt      DateTime?
  verifiedBy          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([contentStatus, availabilityStatus, featured, sortOrder])
  @@index([categoryId])
  @@map("licensing_entries")
}

model Faq {
  id             String        @id @default(cuid())
  questionBn     String
  answerBn       String
  pillar         PillarType?
  isRegulatory   Boolean       @default(false)
  contentStatus  ContentStatus @default(DRAFT)
  sortOrder      Int           @default(0)
  lastVerifiedAt DateTime?
  verifiedBy     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([contentStatus, pillar, sortOrder])
  @@map("faqs")
}

model Lead {
  id                   String            @id @default(cuid())
  publicReference      String            @unique
  idempotencyKey       String            @unique
  name                 String
  mobile               String
  email                String?
  whatsapp             String?
  addressArea          String
  categoryContext      String
  pillar               PillarType        @default(CONSULTANCY)
  targetSlug           String?
  targetTitle          String?
  problemDescription   String
  preferredContact     PreferredContact?
  consentAt            DateTime
  privacyPolicyVersion String            @default("v1.0-2026-11")
  sourcePage           String
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  ipHash               String?
  status               LeadStatus        @default(NEW)
  assignedToId         String?
  assignedTo           AdminUser?        @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  appointments         ConsultationAppointment[]
  internalNotes        String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  contactedAt          DateTime?
  closedAt             DateTime?

  @@index([status, createdAt])
  @@index([pillar, createdAt])
  @@index([mobile])
  @@map("leads")
}

model SiteSetting {
  id                    String   @id @default("default")
  brandName             String   @default("Business Compliance Partner")
  brandDisplayName      String   @default("BUSINESS COMPLIANCE PARTNER")
  brandNameBn           String   @default("বিজনেস কমপ্লায়েন্স পার্টনার")
  taglineBn             String   @default("এক অংশীদার। সম্পূর্ণ সমাধান। আত্মবিশ্বাসী প্রবৃদ্ধি।")
  taglineEn             String   @default("One Partner. Complete Solutions. Confident Growth.")
  logoAssetPath         String   @default("")
  isIdentityProvisional Boolean  @default(false)
  verifiedPhone         String?
  verifiedWhatsapp      String?
  verifiedEmail         String?
  verifiedAddressBn     String?
  verifiedAddressEn     String?
  facebookUrl           String?
  linkedinUrl           String?
  youtubeUrl            String?
  defaultSeoTitleBn     String   @default("Business Compliance Partner | ব্যবসা, কমপ্লায়েন্স, প্রশিক্ষণ ও পরামর্শ")
  defaultSeoDescBn      String   @default("বাংলাদেশের উদ্যোক্তা ও পেশাজীবীদের জন্য কোর্স, ব্যবসায়িক কমপ্লায়েন্স সেবা, লাইসেন্সিং তথ্য ও পরামর্শ সহায়তার একটি সুসংগঠিত প্ল্যাটফর্ম।")
  legalDisclaimerBn     String   @default("Business Compliance Partner (BCP) একটি স্বাধীন পেশাদার সহায়তা প্ল্যাটফর্ম; এটি কোনো সরকারি প্রতিষ্ঠান বা সরকারি পোর্টাল নয়। সকল নিবন্ধন, লাইসেন্স ও অনুমোদন সংশ্লিষ্ট কর্তৃপক্ষের বিধিমালা ও চূড়ান্ত সিদ্ধান্তসাপেক্ষ।")
  legalDisclaimerEn     String   @default("Business Compliance Partner (BCP) is an independent professional learning and business compliance assistance platform; it is not a government institution or official portal.")
  privacyPolicyVersion  String   @default("v1.0-2026-11")
  leadRetentionDays     Int      @default(365)
  stagingNoticeBn       String?  @default("স্টেজিং সংস্করণ — যোগাযোগের তথ্য, মূল্য ও সক্রিয় অফার অনুমোদনসাপেক্ষ।")
  updatedAt             DateTime @updatedAt
  updatedBy             String?

  @@map("site_settings")
}

model AdminUser {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  passwordHash     String
  role             AdminRole         @default(EDITOR)
  isActive         Boolean           @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         AdminSession[]
  assignedLeads    Lead[]            @relation("AssignedLeads")
  auditLogs        AuditLog[]
  contentRevisions ContentRevision[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipHash    String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model ContentRevision {
  id         String     @id @default(cuid())
  entityType String
  entityId   String
  action     String
  snapshot   Json
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("content_revisions")
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  actorRole  AdminRole?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  ipHash     String?
  createdAt  DateTime   @default(now())

  @@index([entityType, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// WAVE 2: 437-RECORD INVENTORY & PROVENANCE SYSTEM
// =============================================================================

model CatalogueSourceRecord {
  id                        String                     @id @default(cuid())
  sourceId                  String                     @unique
  title                     String
  titleBn                   String?
  pillar                    String
  category                  String
  sourceDocument            String
  sourcePages               String
  sourcePageExact           Int?
  documentedStatus          String
  liveAvailability          String
  proposedDomain            String?
  proposedAudience          String?
  proposedJourney           String?
  priceBdt                  Float?
  pricingStatus             String                     @default("QUOTE_REQUIRED")
  authorizedProvider        String?
  approvedScope             String?
  turnaround                String?
  contentVerificationStatus String                     @default("UNVERIFIED")
  publicationStatus         String                     @default("DRAFT")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  mappings                  CatalogueOfferingMapping[]

  @@index([pillar, category])
  @@index([contentVerificationStatus, publicationStatus])
  @@map("catalogue_source_records")
}

model CatalogueOfferingMapping {
  id                    String                @id @default(cuid())
  sourceRecordId        String
  sourceRecord          CatalogueSourceRecord @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)
  canonicalOfferingType String
  canonicalOfferingId   String?
  canonicalOfferingSlug String?
  matchConfidence       Float                 @default(1.0)
  mappingNotes          String?
  createdAt             DateTime              @default(now())

  @@index([sourceRecordId])
  @@index([canonicalOfferingType, canonicalOfferingSlug])
  @@map("catalogue_offering_mappings")
}

model ImportBatch {
  id              String   @id @default(cuid())
  batchNumber     String   @unique
  sourceFile      String
  totalRecords    Int
  importedRecords Int
  skippedRecords  Int
  status          String   @default("COMPLETED")
  log             Json?
  createdAt       DateTime @default(now())

  @@map("import_batches")
}

// =============================================================================
// WAVE 3: CUSTOMER IDENTITY & MULTI-ORGANIZATION SYSTEM
// =============================================================================

model Customer {
  id                  String                    @id @default(cuid())
  email               String                    @unique
  name                String
  mobile              String?
  passwordHash        String
  isVerified          Boolean                   @default(false)
  avatarUrl           String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  sessions            CustomerSession[]
  memberships         OrganizationMembership[]
  serviceRequests     ServiceRequest[]
  quotes              Quote[]
  orders              Order[]
  invoices            Invoice[]
  enrollments         Enrollment[]
  certificates        Certificate[]
  complianceCases     ComplianceCase[]
  documents           Document[]
  appointments        ConsultationAppointment[]

  @@index([email])
  @@map("customers")
}

model CustomerSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

model Organization {
  id                  String                   @id @default(cuid())
  name                String
  tradeLicenseNumber  String?
  bin                 String?
  tin                 String?
  businessType        String?
  address             String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  memberships         OrganizationMembership[]
  serviceRequests     ServiceRequest[]
  complianceCases     ComplianceCase[]
  documents           Document[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  role           String       @default("OWNER")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, customerId])
  @@index([customerId])
  @@map("organization_memberships")
}

// =============================================================================
// WAVE 4: COMMERCE, QUOTES, ORDERS & LMS
// =============================================================================

model ServiceRequest {
  id              String       @id @default(cuid())
  publicReference String       @unique
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  serviceSlug     String
  title           String
  scopeDetails    String
  urgency         String       @default("NORMAL")
  status          String       @default("PENDING_ASSESSMENT")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  quotes          Quote[]
  documents       Document[]

  @@index([status, createdAt])
  @@index([customerId])
  @@map("service_requests")
}

model Quote {
  id                String          @id @default(cuid())
  publicReference   String          @unique
  requestId         String?
  request           ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  totalAmountBdt    Float
  govtFeeBdt        Float?          @default(0)
  bcpServiceFeeBdt  Float?          @default(0)
  status            String          @default("SENT")
  validUntil        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             QuoteItem[]
  orders            Order[]

  @@index([status])
  @@index([customerId])
  @@map("quotes")
}

model QuoteItem {
  id           String @id @default(cuid())
  quoteId      String
  quote        Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description  String
  quantity     Int    @default(1)
  unitPriceBdt Float

  @@map("quote_items")
}

model Order {
  id              String          @id @default(cuid())
  publicReference String          @unique
  idempotencyKey  String?         @unique
  orderKind       String          @default("SERVICE_QUOTE")
  quoteId         String?
  quote           Quote?          @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  totalBdt        Float
  paymentStatus   String          @default("UNPAID")
  status          String          @default("CONFIRMED")
  shippingAddress String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  invoices        Invoice[]
  payments        PaymentRecord[]
  bookItems       BookOrderItem[]

  @@index([paymentStatus, status])
  @@index([customerId])
  @@map("orders")
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amountBdt     Float
  status        String    @default("DUE")
  issuedAt      DateTime  @default(now())
  dueAt         DateTime?
  paidAt        DateTime?

  @@index([status])
  @@index([customerId])
  @@map("invoices")
}

model PaymentRecord {
  id                   String   @id @default(cuid())
  transactionReference String   @unique
  orderId              String
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method               String   @default("SANDBOX")
  amountBdt            Float
  status               String   @default("INITIATED")
  gatewayResponse      Json?
  createdAt            DateTime @default(now())

  @@index([status])
  @@map("payment_records")
}

// LMS Models
model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  titleBn   String
  titleEn   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  lessons   Lesson[]

  @@index([courseId, sortOrder])
  @@map("course_modules")
}

model Lesson {
  id              String           @id @default(cuid())
  moduleId        String
  module          CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  titleBn         String
  titleEn         String?
  durationMinutes Int              @default(15)
  videoUrl        String?
  isFreePreview   Boolean          @default(false)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  progress        LessonProgress[]

  @@index([moduleId, sortOrder])
  @@map("lessons")
}

model Enrollment {
  id                 String           @id @default(cuid())
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status             String           @default("ACTIVE")
  progressPercentage Int              @default(0)
  enrolledAt         DateTime         @default(now())
  completedAt        DateTime?
  progress           LessonProgress[]
  certificates       Certificate[]

  @@unique([customerId, courseId])
  @@index([customerId])
  @@map("enrollments")
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted  Boolean    @default(false)
  completedAt  DateTime?

  @@unique([enrollmentId, lessonId])
  @@map("lesson_progress")
}

model Certificate {
  id                String     @id @default(cuid())
  certificateNumber String     @unique
  enrollmentId      String
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  courseTitleBn     String
  issuedAt          DateTime   @default(now())
  verificationCode  String     @unique

  @@index([customerId])
  @@map("certificates")
}

// =============================================================================
// WAVE 5: COMPLIANCE WORKSPACE, DOCUMENTS & NOTIFICATIONS
// =============================================================================

model ComplianceCase {
  id              String                @id @default(cuid())
  publicReference String                @unique
  organizationId  String?
  organization    Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  titleBn         String
  categorySlug    String
  authorityName   String?
  status          String                @default("ASSESSMENT_PENDING")
  deadline        DateTime?
  renewalDate     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  milestones      ComplianceMilestone[]
  documents       Document[]

  @@index([status])
  @@index([customerId])
  @@map("compliance_cases")
}

model ComplianceMilestone {
  id          String         @id @default(cuid())
  caseId      String
  case        ComplianceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  titleBn     String
  status      String         @default("PENDING")
  completedAt DateTime?
  sortOrder   Int            @default(0)

  @@index([caseId, sortOrder])
  @@map("compliance_milestones")
}

model Document {
  id              String          @id @default(cuid())
  publicReference String          @unique
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organizationId  String?
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  caseId          String?
  complianceCase  ComplianceCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  requestId       String?
  serviceRequest  ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  title           String
  category        String
  fileKey         String
  fileUrl         String
  fileSizeBytes   Int?
  mimeType        String?
  status          String          @default("PENDING_REVIEW")
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("documents")
}

model ConsultationAppointment {
  id              String    @id @default(cuid())
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  scheduledAt     DateTime
  durationMinutes Int       @default(30)
  status          String    @default("REQUESTED")
  meetingNotes    String?
  advisorName     String?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@map("consultation_appointments")
}

model Notification {
  id            String   @id @default(cuid())
  recipientType String   @default("CUSTOMER")
  recipientId   String
  title         String
  message       String
  link          String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([recipientType, recipientId, isRead])
  @@map("notifications")
}

// =============================================================================
// V6: GOVERNED BOOKSTORE & PUBLICATIONS DIVISION
// =============================================================================

model BookCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameBn      String
  nameEn      String
  shortDescBn String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  books       Book[]

  @@index([isActive, sortOrder])
  @@map("book_categories")
}

model Book {
  id                           String                  @id @default(cuid())
  slug                         String                  @unique
  sku                          String?                 @unique
  isbn                         String?
  titleBn                      String
  titleEn                      String
  subtitleBn                   String
  categoryId                   String
  category                     BookCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  summaryBn                    String
  audienceBn                   String
  topicsBn                     String[]
  editionLabel                 String?
  editionNoteBn                String
  pagesCount                   Int?
  languageBnEn                 String?                 @default("বাংলা ও ইংরেজি রেফারেন্স")
  deliveryMode                 String?                 @default("PRINT")
  pricePaisa                   Int?
  stockQuantity                Int                     @default(0)
  contentStatus                ContentStatus           @default(DRAFT)
  availabilityStatus           AvailabilityStatus      @default(UPCOMING)
  featured                     Boolean                 @default(false)
  sortOrder                    Int                     @default(0)
  coverPalette                 Json
  relatedCourseCategorySlug    String?
  relatedServiceCategorySlug   String?
  relatedLicensingCategorySlug String?
  seoTitle                     String?
  seoDescription               String?
  lastVerifiedAt               DateTime?
  verifiedBy                   String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  inventoryMovements           BookInventoryMovement[]
  orderItems                   BookOrderItem[]

  @@index([contentStatus, availabilityStatus, featured, sortOrder])
  @@index([categoryId])
  @@map("books")
}

model BookInventoryMovement {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  reference String?
  createdAt DateTime @default(now())

  @@index([bookId, createdAt])
  @@map("book_inventory_movements")
}

model BookOrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId         String
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Restrict)
  titleSnapshot  String
  quantity       Int      @default(1)
  unitPricePaisa Int
  lineTotalPaisa Int
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([bookId])
  @@map("book_order_items")
}

