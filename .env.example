# ==============================================================================
# PAPERWORK SQUAD — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy to .env.local for local development. NEVER commit real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database (Hosted Supabase / Neon / PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string for runtime queries (Prisma Client)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/paperwork_squad?schema=public&sslmode=require"
# Direct non-pooled connection string for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/paperwork_squad?schema=public&sslmode=require"

# ------------------------------------------------------------------------------
# 2. Application Environment & Canonical URL
# ------------------------------------------------------------------------------
# Use "staging" until client verifies brand, contacts, domain & active offerings.
# Staging enforces X-Robots-Tag: noindex, nofollow and robots.txt Disallow: /
NEXT_PUBLIC_APP_ENV="staging"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Staff Admin Authentication (Server-side HttpOnly Cookie + DB Session)
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET="replace-with-64-hex-char-random-secret-before-running"

# Optional bootstrap super-admin created during `npm run db:seed`
# Leave blank if provisioning admins separately.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_NAME="Platform Administrator"

# ------------------------------------------------------------------------------
# 4. Async Lead Notification Provider
# ------------------------------------------------------------------------------
# Supported: "console" (non-PII structured log in dev/staging) | "resend"
NOTIFICATION_PROVIDER="console"
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL=""
NOTIFICATION_TO_EMAIL=""

# ------------------------------------------------------------------------------
# 5. Bot Protection (Cloudflare Turnstile — optional in local dev, recommended prod)
# ------------------------------------------------------------------------------
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ------------------------------------------------------------------------------
# 6. Privacy-Preserving Analytics & Data Retention
# ------------------------------------------------------------------------------
# Supported: "none" | "custom" (PII is strictly stripped before dispatch)
NEXT_PUBLIC_ANALYTICS_PROVIDER="none"
# Lead retention policy in days (requires client & legal counsel review before launch)
LEAD_RETENTION_DAYS="365"
